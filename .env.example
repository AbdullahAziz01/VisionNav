# ==============================================================================
# VisionNav Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure for your remote server / container.
# NEVER commit real credentials or production tokens to git!

# ------------------------------------------------------------------------------
# Security & Access Protection
# ------------------------------------------------------------------------------
# Secret API key required to access the VisionNav backend endpoints.
# If left empty, access is unrestricted (development mode).
# In production, set this to a cryptographically secure random string (e.g. openssl rand -hex 32).
VISIONNAV_API_KEY=

# Allowed CORS origins. In development, defaults to "*".
# In production, specify your domain or mobile client origin (comma-separated).
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# Server & Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# Maximum allowed frame upload payload size in megabytes.
# Protects server memory from denial-of-service / oversized JPEG uploads.
MAX_UPLOAD_SIZE_MB=10.0

# ------------------------------------------------------------------------------
# Session Isolation & Anti-Mixing
# ------------------------------------------------------------------------------
# Inactivity lease timeout in seconds for an active phone session.
# While a phone session is actively streaming, requests from different session IDs
# are rejected (HTTP 409 Conflict) to prevent corrupting tracking and calibration state.
SESSION_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Model & Cache Locations (Persistent Storage)
# ------------------------------------------------------------------------------
HF_HOME=/app/cache/huggingface
TORCH_HOME=/app/cache/torch
EASYOCR_MODULE_PATH=/app/cache/easyocr

# Depth Anything V2 environment model variant:
# indoor  -> depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf (default)
# outdoor -> depth-anything/Depth-Anything-V2-Metric-Outdoor-Small-hf
DEPTH_ANYTHING_ENVIRONMENT=indoor
